# Google Cloud Console -> APIs & Services -> Credentials
# Enable "Places API (New)" on your project before this key will work.
GOOGLE_PLACES_API_KEY=your_api_key_here

# Redis connection (default assumes a local Redis on the standard port)
REDIS_URL=redis://localhost:6379/0

# PostgreSQL - durable copy of the Redis cache (see app/db.py).
# Use 127.0.0.1, not localhost: on Windows, localhost tries IPv6 first,
# which WSL does not forward, and every connection stalls ~2s.
DATABASE_URL=postgresql://roygortle:change_me@127.0.0.1:5432/best_restaurant

# Ranking / search tunables (see README for the reasoning behind each default)
SEARCH_RADIUS_M=1500
MAX_CANDIDATES=60
MIN_RATING=4.0
MIN_VOTES_THRESHOLD=200
PRIOR_RATING=4.0
WEIGHT_RATING=0.65
WEIGHT_DISTANCE=0.35

# Dense areas (the search filled all MAX_CANDIDATES slots) use these instead,
# and drop candidates below DENSE_MIN_RATING or beyond DENSE_MAX_DISTANCE_M:
# quality matters more than distance when there is plenty of nearby choice.
DENSE_MIN_VOTES_THRESHOLD=500
DENSE_WEIGHT_RATING=0.8
DENSE_WEIGHT_DISTANCE=0.2
DENSE_MIN_RATING=4.3
DENSE_MAX_DISTANCE_M=1000

# 7 days, in seconds - how long a cached place is considered fresh
CACHE_TTL_SECONDS=604800
